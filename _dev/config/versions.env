# _dev/config/versions.env — Single source of truth for all dependency versions.
# Edit here, then run: task generate
#
# Format: KEY=VALUE (no spaces around =, no quotes)

RF_VERSION=7.4
RF_LIB_BROWSER_VERSION=19.14.2
RF_LIB_CRYPTO_VERSION=0.3
PYTHON_VERSION=3.12
PIP_VERSION=23.2.1
NODEJS_VERSION=22.11.0
PYYAML_VERSION=6.0.3

# os/ content type — per-OS base image pins (KEY derived as <SLUG-UPPER>_IMAGE
# by _dev/scripts/generate-all.sh / .ps1; RHEL-compatible is a known exception,
# see that story's task list)
DEBIAN_IMAGE=debian:13
UBUNTU_IMAGE=ubuntu:24.04
SLES_IMAGE=registry.suse.com/suse/sle15:15.7
# rhel slug is a documented exception to the generic <SLUG-UPPER>_IMAGE
# derivation: the key is RHEL_COMPAT_IMAGE, not RHEL_IMAGE, because the pinned
# image is a RHEL-compatible substitute (Rocky Linux), not RHEL itself.
RHEL_COMPAT_IMAGE=rockylinux/rockylinux:10
CENTOS_IMAGE=quay.io/centos/centos:stream9