# ── robotmk-starter ──────────────────────────────────────────────────────────
# RCC environment: Robot Framework and Browser Library, nothing else. RCC also
# fetches Playwright's Chromium (rccPostInstall).
RMKS_ENVIRONMENT=rf-libbrowser
# Devcontainer type: a desktop, so the browser can be watched.
RMKS_DEVCONTAINER=desktop
