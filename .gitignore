# Python virtualenv (used for copier by maintainers)
.venv/

# Shared README template — injected temporarily into each example's template/ dir at generation time
_dev/_examples/*/template/README.md.jinja

# RCC binaries – download via _dev/scripts/download-rcc.sh, do not commit
_dev/.rcc/rcc*

# Robot Framework output artifacts
output/
results/
log.html
report.html
output.xml
browser/screenshot/
playwright-log.txt
os/*/report.md

# RCC holotree (local environment cache)
.robocorp/

# macOS
.DS_Store

# Editor
.vscode/settings.json
*.swp

# BMAD
.agents/
_bmad/
_bmad-output/

nohup.out


__pycache__/*
*.pyc
.claude
