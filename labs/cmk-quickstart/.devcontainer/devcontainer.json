{
  "name": "cmk-quickstart",
  "dockerComposeFile": "docker-compose.yml",
  "service": "host",
  "workspaceFolder": "/workspaces",
  "overrideCommand": false,
  "remoteUser": "root",
  "containerEnv": {
    "CMK_URL": "http://cmk:5000/cmk",
    "CMK_SITE_ID": "cmk"
  },
  "remoteEnv": {
    "DISPLAY": ":1",
    "ROBOLAND_KEY": "${localEnv:ROBOLAND_KEY}"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "d-biehl.robotcode"]
    }
  },
  "forwardPorts": [6080, "cmk:5000"],
  "portsAttributes": {
    "6080": { "label": "Desktop (noVNC)", "onAutoForward": "openBrowser" },
    "cmk:5000": { "label": "Checkmk", "onAutoForward": "notify" }
  }
}
