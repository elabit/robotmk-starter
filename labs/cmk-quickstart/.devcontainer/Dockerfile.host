FROM debian:12

# systemd is the whole point of this container. The Checkmk agent installs
# itself as a set of systemd units — socket, async service, controller daemon —
# exactly as it would on a real machine. Without systemd the package needs four
# workarounds, and the learner would practise four handgrips that do not exist
# outside a lab. See ADR-0072 in the academy repository.
# The desktop runs as systemd units, never as a devcontainer feature: features
# that carry "init" take PID 1 away from systemd, and then the agent cannot be
# installed the honest way. Measured — see ADR-0072.
RUN apt-get update && apt-get install -y --no-install-recommends \
      systemd systemd-sysv dbus ca-certificates curl wget sudo git \
      procps less socat \
      tigervnc-standalone-server tigervnc-common fluxbox \
      novnc websockify x11-utils x11-xserver-utils xterm \
 && rm -rf /var/lib/apt/lists/* \
 && rm -f /lib/systemd/system/multi-user.target.wants/* \
          /etc/systemd/system/*.wants/* \
          /lib/systemd/system/sockets.target.wants/*udev*

# procps is not optional here: the Checkmk agent builds its <<<ps_lnx>>> section
# with `ps ax` (check_mk_agent.linux:870) and uses ps in three more places.
# Debian's minimal image has none of it, so process monitoring would silently
# come up empty — in a monitoring course.
# No system browser either. Playwright brings its own, fetched by RCC, and the
# Checkmk web interface is reached through the forwarded port in the learner's
# own browser. The desktop exists only so the browser the TEST starts is visible.
# RCC and the Checkmk agent are deliberately NOT installed here. Installing them
# is what the course teaches; a lab that pre-installs them teaches nothing.

# Debian's novnc ships vnc.html but no index.html, so websockify serves a bare
# directory listing on port 6080. Send the learner straight into the viewer.
RUN printf '%s\n' \
      '<!doctype html><meta charset="utf-8">' \
      '<title>Roboland Lab desktop</title>' \
      '<meta http-equiv="refresh" content="0; url=vnc.html?autoconnect=true&amp;resize=remote">' \
      '<p>Opening the desktop&hellip; <a href="vnc.html?autoconnect=true&amp;resize=remote">continue</a>' \
      > /usr/share/novnc/index.html

COPY fluxbox/ /root/.fluxbox/
COPY units/*.service /etc/systemd/system/
RUN systemctl enable vncserver fluxbox novnc desktop-session checkmk-port

STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/sbin/init"]
